@model _25DH110028_MyStore.Models.Order

@{
    ViewBag.Title = "Chi tiết Đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-center" style="padding: 10px;">CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h2>

<div class="panel panel-default">
    <div class="panel-body">
        <p><strong>Khách hàng:</strong> @(Model.Customer != null ? Model.Customer.CustomerName : "N/A")</p>
        <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate</p>
        <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
        <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
        <p><strong>Trạng thái:</strong> <span class="label label-info">@Model.PaymentStatus</span></p>
        <p><strong>Tổng tiền:</strong> <span style="color: red; font-weight: bold;">@Model.TotalAmount.ToString("N0") đ</span></p>
    </div>
</div>

<h3>Danh sách sản phẩm trong đơn</h3>
<table class="table table-bordered">
    <thead>
        <tr class="bg-success">
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var detail in Model.OrderDetails)
        {
            <tr>
                <td>@(detail.Product != null ? detail.Product.ProductName : "Sản phẩm")</td>
                <td>@detail.Quantity</td>
                <td>@detail.UnitPrice.ToString("N0") đ</td>
                <td>@((detail.Quantity * detail.UnitPrice).ToString("N0")) đ</td>
            </tr>
        }
    </tbody>
</table>

<p style="margin-top: 20px;">
    @Html.ActionLink("Quay lại danh sách đơn hàng", "Index", null, new { @class = "btn btn-default" })
</p>