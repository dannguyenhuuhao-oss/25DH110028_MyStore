@{
    string ctrl = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    Func<string[], string> act = names =>
        names.Any(n => string.Equals(n, ctrl, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản trị The Kings Bookshop</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/myStyle/AdminLayout.css" />
    @* Chart.js: nếu layout cũ của bạn có dòng nạp Chart.js thì thêm lại ở đây *@
    @RenderSection("Styles", required: false)
</head>
<body>

    @* ============ THANH ĐẦU ============ *@
    <header class="ad-header">
        <div class="ad-header-inner">
            <a class="ad-logo" href="@Url.Action("Index", "Home", new { area = "Admin" })">
                THE <b>KINGS</b> <span class="ad-badge">Admin Management</span>
            </a>

            <div class="ad-user">
                <span class="ad-user-icon"><i class="fas fa-user"></i></span>
                <span class="ad-hello">Xin chào, <strong>@User.Identity.Name</strong></span>
                <a class="ad-logout" href="@Url.Action("Logout", "Account", new { area = "" })">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </a>
            </div>
        </div>
    </header>

    @* ============ THANH MENU ============ *@
    <nav class="ad-nav">
        <div class="ad-nav-inner">

            <a class="@act(new[] { "Home" })" href="@Url.Action("Index", "Home", new { area = "Admin" })">
                <i class="fas fa-home"></i> Tổng quan
            </a>

            <!-- Đưa Quản lý danh mục ra ngoài thành nút riêng -->
            <a class="@act(new[] { "Categories" })" href="@Url.Action("Index", "Categories", new { area = "Admin" })">
                <i class="fas fa-list"></i> Danh mục sản phẩm
            </a>

            <!-- Đưa Quản lý hàng hóa ra ngoài thành nút riêng -->
            <a class="@act(new[] { "Products" })" href="@Url.Action("Index", "Products", new { area = "Admin" })">
                <i class="fas fa-box"></i> Quản lý hàng hóa
            </a>

            <!-- Đưa Quản lý kho hàng ra ngoài thành nút riêng -->
            <a class="@act(new[] { "Stock" })" href="@Url.Action("Index", "Stock", new { area = "Admin" })">
                <i class="fas fa-warehouse"></i> Quản lý kho hàng
            </a>

            <a class="@act(new[] { "Customers" })" href="@Url.Action("Index", "Customers", new { area = "Admin" })">
                <i class="fas fa-users"></i> Khách hàng
            </a>

            <a class="@act(new[] { "Orders" })" href="@Url.Action("Index", "Orders", new { area = "Admin" })">
                <i class="fas fa-shopping-cart"></i> Đơn hàng
            </a>

            <a class="@act(new[] { "Users" })" href="@Url.Action("Index", "Users", new { area = "Admin" })">
                <i class="fas fa-user-cog"></i> Tài khoản
            </a>

            <span class="ad-nav-spacer"></span>
            <a class="ad-nav-right" href="@Url.Action("Index", "Home", new { area = "" })">
                <i class="fas fa-external-link-alt"></i> Về trang chính
            </a>
        </div>
    </nav>

    @* ============ NỘI DUNG ============ *@
    <main class="ad-main">
        <div class="ad-content">
            @RenderBody()
        </div>
    </main>

    @* ============ CHÂN TRANG ============ *@
    <footer class="ad-footer">
        &copy; @DateTime.Now.Year - The Kings Bookshop · Khu vực quản trị
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>