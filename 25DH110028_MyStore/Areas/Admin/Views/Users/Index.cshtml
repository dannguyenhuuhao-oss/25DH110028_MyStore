@model IEnumerable<_25DH110028_MyStore.Models.User>

@{
    ViewBag.Title = "Quản lý tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-center" style="padding: 10px;">QUẢN LÝ TÀI KHOẢN NGƯỜI DÙNG</h2>

<p style="margin-top: 15px;">
    @Html.ActionLink("Thêm mới tài khoản", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-bordered table-striped" style="margin-top: 15px;">
    <tr>
        <th class="bg-success">Tên đăng nhập (Username)</th>
        <th class="bg-success">Phân quyền (UserRole)</th>
        <th class="bg-success">Thao tác</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Username)</td>
            <td>@Html.DisplayFor(modelItem => item.UserRole)</td>
            <td>
                <!-- Sửa các nút Sửa, Chi tiết, Xóa thành dạng truyền tham số QueryString -->
                <a href="@Url.Action("Edit", "Users", new { username = item.Username })" class="btn btn-primary btn-sm">Sửa</a>
                <a href="@Url.Action("Details", "Users", new { username = item.Username })" class="btn btn-info btn-sm">Chi tiết</a>
                <a href="@Url.Action("Delete", "Users", new { username = item.Username })" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa tài khoản này?');">Xóa</a>
            </td>
        </tr>
    }
</table>