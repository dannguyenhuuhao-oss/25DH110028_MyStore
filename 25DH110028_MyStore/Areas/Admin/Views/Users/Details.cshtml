@model _25DH110028_MyStore.Models.User

@{
    ViewBag.Title = "Chi tiết tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-center" style="padding: 10px;">CHI TIẾT TÀI KHOẢN</h2>

<div class="panel panel-default" style="margin-top: 20px;">
    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Tên đăng nhập:</dt>
            <dd>@Model.Username</dd>

            <dt>Mật khẩu:</dt>
            <dd>@Model.Password</dd>

            <dt>Vai trò:</dt>
            <dd><span class="label label-info">@Model.UserRole</span></dd>
        </dl>
    </div>
</div>

<p style="margin-top: 20px;">
    @Html.ActionLink("Sửa", "Edit", new { id = Model.Username }, new { @class = "btn btn-primary" }) |
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
</p>