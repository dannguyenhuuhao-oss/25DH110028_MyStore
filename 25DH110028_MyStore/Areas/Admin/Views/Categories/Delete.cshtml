@model _25DH110028_MyStore.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="alert alert-success">XÓA DANH MỤC</h2>


@using (Html.BeginForm())
{
        @Html.AntiForgeryToken()
<div class="form-horizontal">
    <h4 class="bg-danger">Có chắc là xóa danh mục này không A Guột?</h4>
    <div class="form-group">
        <div class="col-md-2">Tên danh mục</div>
        <div class="col-md-10">
            @Html.DisplayFor(model => model.CategoryName)
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10"></div>
        <input type="submit" value="Xóa" class="btn btn-primary" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary " })
    </div>
</div>
    }

