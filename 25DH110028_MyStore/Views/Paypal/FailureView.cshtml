@{
    ViewBag.Title = "Thanh toán thất bại";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container" style="text-align: center; padding: 50px;">
    <h2 style="color: #d9534f; font-weight: bold;">Thanh toán qua PayPal không thành công!</h2>
    <p style="font-size: 16px; margin: 20px 0;">Đã xảy ra lỗi trong quá trình xử lý giao dịch hoặc bạn đã hủy thanh toán.</p>
    <a href="@Url.Action("Checkout", "Order")" class="btn btn-primary" style="background-color: #1b7b8a; border: none; padding: 10px 25px; border-radius: 20px;">Quay lại trang thanh toán</a>
</div>