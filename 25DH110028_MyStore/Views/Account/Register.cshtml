@model _25DH110028_MyStore.Models.ViewModel.RegisterVM
@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerAccount.css" />

<div class="account-card">
    <h2>Đăng ký tài khoản</h2>
    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "account-error" })

        <div class="account-field">
            @Html.LabelFor(m => m.Username)
            @Html.TextBoxFor(m => m.Username, new { @class = "account-input" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "account-error" })
        </div>
        <div class="account-field">
            @Html.LabelFor(m => m.Password)
            @Html.PasswordFor(m => m.Password, new { @class = "account-input" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "account-error" })
        </div>
        <div class="account-field">
            @Html.LabelFor(m => m.ConfirmPassword)
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "account-input" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "account-error" })
        </div>
        <div class="account-field">
            @Html.LabelFor(m => m.CustomerName)
            @Html.TextBoxFor(m => m.CustomerName, new { @class = "account-input" })
            @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "account-error" })
        </div>
        <div class="account-field">
            @Html.LabelFor(m => m.CustomerPhone)
            @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "account-input" })
            @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "account-error" })
        </div>
        <div class="account-field">
            @Html.LabelFor(m => m.CustomerEmail)
            @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "account-input" })
            @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "account-error" })
        </div>
        <div class="account-field">
            @Html.LabelFor(m => m.CustomerAddress)
            @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "account-input" })
            @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "account-error" })
        </div>

        <input type="submit" value="Đăng ký" class="account-btn" />
        <p class="account-link">Bạn đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a></p>
    }
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}